{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDAM",
  "version": "0.1.0",
  "identifier": "com.opendam.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run vite:dev",
    "beforeBuildCommand": "bun run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenDAM",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**",
            "**/*",
            "$APPDATA/**",
            "$APPDATA/**/*",
            "$HOME/**",
            "$HOME/**/*",
            "$DESKTOP/**",
            "$DESKTOP/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}