{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "unicorn"],
  // Correctness only: the formatter owns style, so a lint failure should mean a defect.
  // Vendored from Mission Control, replaced whole on update: never edited here.
  "ignorePatterns": [".github/actions/mission-flake-report/**"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // React Compiler rules. The app doesn't use the compiler, and the code they
    // flag (resetting edit state on selection change, Date.now() in date filters, the
    // virtualizer's non-memoizable API) is intended.
    "react/incompatible-library": "off",
    "react/purity": "off",
    "react/set-state-in-effect": "off"
  }
}
