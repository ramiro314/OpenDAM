{
  "name": "opendam",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source digital asset manager for 3D/AEC/design files",
  "workspaces": ["apps/desktop"],
  "scripts": {
    "dev": "bun run --filter @opendam/desktop dev",
    "build": "bun run --filter @opendam/desktop build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.6.3"
  }
}
